<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="auction.client.LoginController"
      alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f0f4f8;">
    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <!-- Header Title -->
    <VBox alignment="CENTER" spacing="5">
        <Label text="🏆 UET Online Auction"
               style="-fx-text-fill: #0d47a1; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Hệ thống Đấu giá Trực tuyến - Nhóm 01"
               style="-fx-text-fill: #546e7a; -fx-font-size: 12px;"/>
    </VBox>

    <!-- Custom Segmented Tab Bar -->
    <HBox alignment="CENTER" spacing="5" 
          style="-fx-background-color: #e1eaf4; -fx-background-radius: 20; -fx-padding: 4; -fx-border-color: #bbdefb; -fx-border-radius: 20;">
        <Button fx:id="btnTabLogin" text="Đăng nhập" onAction="#showLoginPanel"
                prefWidth="110"
                style="-fx-background-color: #1e88e5; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 8 0;"/>
        <Button fx:id="btnTabRegister" text="Đăng ký" onAction="#showRegisterPanel"
                prefWidth="110"
                style="-fx-background-color: transparent; -fx-text-fill: #1565c0;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 8 0;"/>
        <Button fx:id="btnTabForgot" text="Quên MK" onAction="#showForgotPanel"
                prefWidth="110"
                style="-fx-background-color: transparent; -fx-text-fill: #1565c0;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 8 0;"/>
    </HBox>

    <!-- Container for dynamic panels -->
    <StackPane VBox.vgrow="ALWAYS" minHeight="260">
        
        <!-- PANEL 1: LOGIN -->
        <VBox fx:id="loginPanel" spacing="12" alignment="CENTER">
            <TextField fx:id="loginUsernameField" promptText="Tên đăng nhập"
                       maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <PasswordField fx:id="loginPasswordField" promptText="Mật khẩu"
                           maxWidth="320"
                           style="-fx-background-color: white; -fx-text-fill: #212121;
                                  -fx-border-color: #bbdefb; -fx-border-radius: 5;
                                  -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <Button fx:id="loginButton" text="🚀 Đăng nhập ngay"
                    onAction="#handleLogin"
                    maxWidth="320"
                    style="-fx-background-color: #1e88e5; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>

        <!-- PANEL 2: REGISTER -->
        <VBox fx:id="registerPanel" spacing="12" alignment="CENTER" visible="false">
            <TextField fx:id="regUsernameField" promptText="Tên đăng ký mới"
                       maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <PasswordField fx:id="regPasswordField" promptText="Mật khẩu bảo mật"
                           maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <TextField fx:id="regEmailField" promptText="Địa chỉ Email"
                       maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <ComboBox fx:id="regRoleComboBox" promptText="Vai trò người dùng"
                      maxWidth="320" prefHeight="40"
                      style="-fx-background-color: white; -fx-text-fill: #212121;
                             -fx-border-color: #bbdefb; -fx-border-radius: 5;
                             -fx-background-radius: 5; -fx-font-size: 13px;"/>
            <Button fx:id="registerButton" text="📝 Đăng ký tài khoản"
                    onAction="#handleRegister"
                    maxWidth="320"
                    style="-fx-background-color: #1e88e5; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>

        <!-- PANEL 3: FORGOT PASSWORD -->
        <VBox fx:id="forgotPanel" spacing="12" alignment="CENTER" visible="false">
            <TextField fx:id="forgotUsernameField" promptText="Tên đăng nhập cần khôi phục"
                       maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <TextField fx:id="forgotEmailField" promptText="Email đã đăng ký"
                       maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <PasswordField fx:id="forgotPasswordField" promptText="Mật khẩu mới mong muốn"
                           maxWidth="320"
                       style="-fx-background-color: white; -fx-text-fill: #212121;
                              -fx-border-color: #bbdefb; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            <Button fx:id="forgotButton" text="🔑 Xác nhận đổi mật khẩu"
                    onAction="#handleForgotPassword"
                    maxWidth="320"
                    style="-fx-background-color: #1e88e5; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>
    </StackPane>

    <!-- Global Feedback Status Label -->
    <Label fx:id="statusLabel" text="" wrapText="true" textAlignment="CENTER"
           style="-fx-text-fill: #0d47a1; -fx-font-size: 12px; -fx-font-weight: bold;"/>
</VBox>
