<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="auction.client.BiddingController"
      spacing="12" style="-fx-background-color: #1a1a2e;">
    <padding>
        <Insets top="15" right="20" bottom="15" left="20"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: transparent; -fx-text-fill: #a8a8b3;
                       -fx-border-color: #a8a8b3; -fx-border-radius: 4;
                       -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"/>
        <Label fx:id="labelAuctionTitle"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="15" VBox.vgrow="ALWAYS">

        <!-- Left Panel: Bidding Controls -->
        <VBox spacing="14" minWidth="280" maxWidth="300"
              style="-fx-background-color: #16213e; -fx-background-radius: 8; -fx-padding: 20;">

            <Label text="Giá cao nhất hiện tại"
                   style="-fx-text-fill: #a8a8b3; -fx-font-size: 12px;"/>
            <Label fx:id="labelCurrentBid" text="0 ₫"
                   style="-fx-text-fill: #e94560; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label fx:id="labelStatus" text=""
                   style="-fx-text-fill: #f5c518; -fx-font-size: 12px;" wrapText="true"/>

            <Separator style="-fx-background-color: #0f3460;"/>

            <Label text="Nhập giá của bạn (₫)"
                   style="-fx-text-fill: #a8a8b3; -fx-font-size: 12px;"/>
            <TextField fx:id="bidAmountField" promptText="VD: 1500000"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: white;
                              -fx-border-color: #0f3460; -fx-border-radius: 5;
                              -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 15px;"/>

            <Button fx:id="placeBidButton" text="⚡ ĐẶT GIÁ NGAY"
                    onAction="#handlePlaceBid"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e94560; -fx-text-fill: white;
                           -fx-font-size: 15px; -fx-font-weight: bold;
                           -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>

            <!-- Bid History -->
            <Label text="Lịch sử đặt giá"
                   style="-fx-text-fill: #a8a8b3; -fx-font-size: 12px;"/>
            <TableView fx:id="bidHistoryTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #1a1a2e; -fx-border-color: #0f3460;">
                <columns>
                    <TableColumn fx:id="colBidder" text="Người đặt" prefWidth="100"/>
                    <TableColumn fx:id="colAmount" text="Giá (₫)" prefWidth="100"/>
                    <TableColumn fx:id="colTime" text="Thời gian" prefWidth="80"/>
                </columns>
                <placeholder>
                    <Label text="Chưa có lịch sử." style="-fx-text-fill: #a8a8b3;"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Right Panel: Price Chart -->
        <VBox VBox.hgrow="ALWAYS" spacing="8">
            <Label text="📈 Biểu đồ giá Realtime"
                   style="-fx-text-fill: #a8a8b3; -fx-font-size: 13px;"/>
            <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #16213e; -fx-background-radius: 8;">
                <xAxis>
                    <NumberAxis fx:id="xAxis" label="Thời gian (giây)" lowerBound="0"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxis" label="Giá (₫)"/>
                </yAxis>
            </LineChart>
        </VBox>
    </HBox>
</VBox>
