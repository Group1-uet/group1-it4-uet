<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="1080.0" prefWidth="1920.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.AdminController">
    <VBox spacing="25" VBox.vgrow="ALWAYS">
        <padding><Insets bottom="40" left="40" right="40" top="40"/></padding>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="5">
                <Label styleClass="header-greeting" text="Hệ thống quản trị viên"/>
                <Label styleClass="subtitle" text="Quản lý toàn bộ người dùng, giao dịch và sản phẩm đấu giá"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onLogout" styleClass="primary" text="Đăng xuất"/>
        </HBox>

        <!-- TABPANE -->
        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: USERS -->
            <Tab text="Quản lý người dùng" closable="false">
                <VBox spacing="20" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="30" left="30" right="30" top="30"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label styleClass="card-title" text="Danh sách tài khoản hệ thống"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onReloadUsers" text="Làm mới"/>
                    </HBox>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userNameCol" prefWidth="250" text="Tên đăng nhập"/>
                            <TableColumn fx:id="userDisplayCol" prefWidth="250" text="Tên hiển thị"/>
                            <TableColumn fx:id="userRoleCol" prefWidth="150" text="Vai trò"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 2: AUCTIONS -->
            <Tab text="Quản lý phiên đấu giá" closable="false">
                <VBox spacing="20" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="30" left="30" right="30" top="30"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label styleClass="card-title" text="Danh sách tất cả phiên đấu giá"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onReloadAuctions" text="Làm mới"/>
                        <Button onAction="#onCancel" styleClass="btn-danger,primary" text="Hủy phiên chọn"/>
                    </HBox>
                    <TableView fx:id="auctionsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="auctionNameCol" prefWidth="400" text="Tên sản phẩm"/>
                            <TableColumn fx:id="auctionOwnerCol" prefWidth="200" text="Người đăng"/>
                            <TableColumn fx:id="auctionStateCol" prefWidth="150" text="Trạng thái"/>
                            <TableColumn fx:id="auctionPriceCol" prefWidth="200" text="Giá hiện tại ($)"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>

        <!-- FOOTER -->
        <HBox alignment="CENTER_RIGHT">
            <Button onAction="#onMain" text="Quay lại dashboard chính"/>
        </HBox>
    </VBox>
</StackPane>