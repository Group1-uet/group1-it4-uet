<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="1080.0" prefWidth="1920.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.LoginController">

    <VBox alignment="CENTER" maxHeight="450" maxWidth="400" spacing="25" styleClass="card">

        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>

        <VBox alignment="CENTER" spacing="8">
            <Label styleClass="title" text="Online Auction" />
            <Label styleClass="subtitle" text="Sign in to start bidding" />
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Username" />
                <TextField fx:id="usernameField" promptText="e.g. bob" />
            </VBox>

            <VBox spacing="5">
                <Label text="Password" />
                <PasswordField fx:id="passwordField" promptText="••••••••" />
            </VBox>
        </VBox>

        <VBox alignment="CENTER" spacing="15">
            <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" styleClass="primary" text="Login" />

            <HBox alignment="CENTER" spacing="5">
                <Label styleClass="muted" text="Don't have an account?" />
                <Hyperlink fx:id="registerLink" text="Register" onAction="#goToRegister"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>