<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.LoginController">

    <VBox alignment="CENTER" maxHeight="450" maxWidth="400" spacing="20" style="-fx-background-color: white;                  -fx-background-radius: 10;                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <padding>
            <Insets bottom="40" left="40" right="40" top="40" />
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Online Auction" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Sign in to start bidding" />
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label style="-fx-font-weight: bold;" text="Username" />
                <TextField fx:id="usernameField" promptText="e.g. bob" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold;" text="Password" />
                <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
            </VBox>
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" style="-fx-background-color: #3498db; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-pref-height: 40; -fx-cursor: hand;" text="Login" />

            <HBox alignment="CENTER" spacing="5">
                <Label style="-fx-text-fill: #7f8c8d;" text="Don't have an account?" />
                <Button fx:id="registerButton" style="-fx-background-color: transparent; -fx-text-fill: #3498db;                                -fx-padding: 0; -fx-cursor: hand; -fx-underline: true;" text="Register" />
            </HBox>
        </VBox>

    </VBox>
</StackPane>
