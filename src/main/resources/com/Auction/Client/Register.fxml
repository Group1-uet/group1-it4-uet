<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<StackPane prefHeight="800.0" prefWidth="1200.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.RegisterController">

    <VBox alignment="CENTER" maxHeight="620" maxWidth="450" spacing="25" styleClass="card">

        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>

        <VBox alignment="CENTER" spacing="8">
            <Label styleClass="title" text="Register" />
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Username" />
                <TextField fx:id="usernameField" promptText="Choose a username" />
            </VBox>

            <VBox spacing="5">
                <Label text="Password" />
                <PasswordField fx:id="passwordField" promptText="Minimum 3 characters" />
            </VBox>

            <VBox spacing="5">
                <Label text="Confirm Password" />
                <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password" />
            </VBox>

            <VBox spacing="5">
                <Label text="Register as" />
                <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Select your role" />
            </VBox>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 13px;" text="" wrapText="true" />

        <VBox alignment="CENTER" spacing="15">
            <Button fx:id="registerButton" maxWidth="Infinity" onAction="#onRegister" styleClass="primary" text="Register Now" />

            <HBox alignment="CENTER" spacing="5">
                <Label styleClass="muted" text="Already have an account?" />
                <Hyperlink id="loginLink" text="Login" onAction="#goToLogin"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>
