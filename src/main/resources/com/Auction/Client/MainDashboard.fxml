<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="800.0" prefWidth="1200.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.MainController">
    <BorderPane maxHeight="Infinity" maxWidth="Infinity">
        <!-- Sidebar -->
        <left>
            <VBox prefWidth="280" styleClass="sidebar-container">
                <padding>
                    <Insets top="40" bottom="30" />
                </padding>

                <!-- Logo Area -->
                <VBox alignment="CENTER" spacing="10">
                    <HBox alignment="CENTER" spacing="10">
                        <StackPane styleClass="logo-icon-bg">
                            <Label styleClass="logo-icon" text="A" />
                        </StackPane>
                        <Label styleClass="logo-text" text="AuctionPro" />
                    </HBox>
                    <Separator maxWidth="200" styleClass="sidebar-separator" />
                </VBox>

                <Region prefHeight="60" />

                <!-- Navigation Links -->
                <VBox spacing="15" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets left="20" right="20" />
                    </padding>

                    <ToggleButton fx:id="btnDashboard" maxWidth="Infinity" styleClass="nav-item" text="Tổng quan Dashboard" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="mainNav" />
                        </toggleGroup>
                    </ToggleButton>

                    <ToggleButton fx:id="btnAuctions" maxWidth="Infinity" styleClass="nav-item" text="Sàn đấu giá trực tuyến" toggleGroup="$mainNav" />

                    <ToggleButton fx:id="btnSeller" maxWidth="Infinity" styleClass="nav-item" text="Kênh người bán hàng" toggleGroup="$mainNav" />

                    <ToggleButton fx:id="btnAdmin" maxWidth="Infinity" styleClass="nav-item" text="Quản trị hệ thống" toggleGroup="$mainNav" />
                </VBox>

                <!-- Bottom User Card -->
                <VBox spacing="15" alignment="CENTER">
                    <VBox styleClass="sidebar-user-card">
                        <padding>
                            <Insets bottom="15" left="15" right="15" top="15" />
                        </padding>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Circle radius="20" fill="#3b82f6" />
                            <VBox>
                                <Label fx:id="userLabel" styleClass="sidebar-user-name" text="User Name" />
                                <Label styleClass="sidebar-user-status" text="Online" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <Button onAction="#onLogout" styleClass="nav-logout-btn" text="Đăng xuất khỏi hệ thống" />
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="25" styleClass="main-content-area">
                <padding>
                    <Insets top="30" left="35" right="35" bottom="30" />
                </padding>

                <!-- Welcome Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label styleClass="header-greeting" text="Bảng điều khiển hệ thống" />
                        <Label styleClass="subtitle" text="Theo dõi các sản phẩm đấu giá mới nhất tại đây." />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button styleClass="primary" text="+ Tạo đấu giá mới" onAction="#gotoSeller" />
                </HBox>

                <!-- Latest Auctions Table -->
                <VBox spacing="20" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25" left="25" right="25" top="25" />
                    </padding>

                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="card-title" text="🔥 Sản phẩm vừa thầu mới nhất" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField prefWidth="250" promptText="Tìm nhanh..." styleClass="search-box" />
                    </HBox>

                    <!-- Sửa TableView với tỷ lệ phần trăm cho các cột -->
                    <TableView fx:id="latestAuctionsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="nameCol" text="Sản phẩm" />
                            <TableColumn fx:id="currentPriceCol" text="Giá hiện tại" />
                            <TableColumn fx:id="lastBidTimeCol" text="Thời điểm thầu cuối" />
                            <TableColumn fx:id="statusCol" text="Trạng thái" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>