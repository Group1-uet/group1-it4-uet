<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="1080.0" prefWidth="1920.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.BidderController">
    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

        <VBox maxWidth="450" prefWidth="400" spacing="25" styleClass="card">
            <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="50">
                <FontIcon iconColor="black" iconLiteral="fas-arrow-left" iconSize="25" onMouseClicked="#onHome" styleClass="standalone-icon">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </FontIcon>
                <Label styleClass="title" text="Sàn Đấu Giá" />
            </HBox>

            <Separator />

            <VBox spacing="20">
                <VBox spacing="10">
                    <Label styleClass="label" text="Tìm kiếm sản phẩm" />
                    <TextField fx:id="searchField" promptText="Nhập tên sản phẩm..." />
                </VBox>

                <VBox spacing="10">
                    <Label styleClass="label" text="Lọc theo danh mục" />
                    <ComboBox fx:id="categoryFilter" maxWidth="Infinity" promptText="Tất cả danh mục" />
                </VBox>

                <VBox spacing="10">
                    <Label styleClass="label" text="Sắp xếp theo" />
                    <ChoiceBox fx:id="sortChoice" maxWidth="Infinity" />
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-background-radius: 15; -fx-padding: 20;">
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Số dư khả dụng" />
                <Label fx:id="balanceLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="0.00 $" />
                <Button maxWidth="Infinity" styleClass="primary" text="Nạp tiền" />
            </VBox>
        </VBox>

        <VBox spacing="25" HBox.hgrow="ALWAYS">

            <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="25" left="25" right="25" top="25" /></padding>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="Phiên đấu giá đang diễn ra" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button graphicTextGap="10" onAction="#onRefresh" text="Làm mới">
                        <graphic>
                            <FontIcon iconColor="black" iconLiteral="fas-sync-alt" iconSize="20" />
                        </graphic>
                    </Button>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <FlowPane fx:id="auctionFlowPane" hgap="20" vgap="20">
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <VBox prefHeight="350" spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="25" left="25" right="25" top="25" /></padding>
                <Label styleClass="card-title" text="Lịch sử thầu của bạn" />

                <TableView fx:id="myBidsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="bidNameCol" prefWidth="350" text="Sản phẩm" />
                        <TableColumn fx:id="myBidCol" prefWidth="180" text="Giá thầu của bạn" />
                        <TableColumn fx:id="statusCol" prefWidth="150" text="Trạng thái" />
                        <TableColumn fx:id="bidTimeCol" prefWidth="220" text="Thời gian" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </HBox>
</StackPane>