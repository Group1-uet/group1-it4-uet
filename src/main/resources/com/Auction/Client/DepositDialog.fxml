<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" stylesheet="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.DepositDialogController" prefWidth="400.0" prefHeight="300.0" styleClass="card">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30"/>
    </padding>

    <!-- TITLE -->
    <Label fx:id="titleLabel" styleClass="title" text="Nạp tiền"/>

    <!-- AMOUNT INPUT -->
    <VBox spacing="8.0">
        <Label text="Nhập số tiền ($):"/>
        <TextField fx:id="amountField" promptText="Ví dụ: 100.00"/>
    </VBox>

    <!-- FEE NOTE (visible only for withdraw) -->
    <Label fx:id="feeNoteLabel" styleClass="muted" text="* Phí nạp tiền: 0%" visible="false" wrapText="true"/>

    <!-- ERROR/STATUS MESSAGE -->
    <Label fx:id="messageLabel" styleClass="error" text="" wrapText="true"/>

    <!-- BUTTONS -->
    <VBox spacing="10.0" alignment="CENTER">
        <Button fx:id="submitButton" onAction="#onSubmit" maxWidth="Infinity" styleClass="primary" text="Xác nhận"/>
        <Button fx:id="cancelButton" onAction="#onCancel" maxWidth="Infinity" text="Hủy bỏ"/>
    </VBox>
</VBox>