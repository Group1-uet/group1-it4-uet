<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox prefHeight="1080.0" prefWidth="1920.0" spacing="30" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Auction.Client.Controller.SellerController">
    <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

    <VBox maxWidth="500" prefWidth="450" spacing="20" styleClass="card">
        <padding><Insets bottom="35" left="35" right="35" top="35" /></padding>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button onAction="#onHome" styleClass="primary">
                <graphic>
                    <FontIcon iconColor="white" iconLiteral="fas-home" iconSize="20" />
                </graphic>
            </Button>
            <Label styleClass="title" text="Đăng sản phẩm" />
        </HBox>

        <Separator />

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="15">
                <VBox spacing="8">
                    <Label styleClass="label" text="Danh mục sản phẩm" />
                    <ChoiceBox fx:id="categoryChoice" maxWidth="Infinity" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="label" text="Tên sản phẩm" />
                    <TextField fx:id="nameField" promptText="Ví dụ: Laptop Dell XPS 15" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="label" text="Mô tả sản phẩm" />
                    <TextArea fx:id="descriptionArea" prefHeight="150" promptText="Mô tả tình trạng, cấu hình..." wrapText="true" />
                </VBox>

                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    <children>
                        <VBox spacing="8" GridPane.columnIndex="0">
                            <Label styleClass="label" text="Giá khởi điểm ($)" />
                            <TextField fx:id="startPriceField" text="10.0" />
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1">
                            <Label styleClass="label" text="Bước giá tối thiểu" />
                            <TextField fx:id="minIncField" text="1.0" />
                        </VBox>
                        <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label styleClass="label" text="Thời lượng (phút)" />
                            <TextField fx:id="durationField" text="60" />
                        </VBox>
                        <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label styleClass="label" text="Chống bắn tỉa (s)" />
                            <TextField fx:id="antiSnipeWindowField" text="30" />
                        </VBox>
                    </children>
                </GridPane>

                <Region prefHeight="20" />
                <Button fx:id="createButton" maxWidth="Infinity" onAction="#onCreate" prefHeight="50" styleClass="primary" text="Bắt đầu phiên đấu giá" />
                <Label fx:id="messageLabel" styleClass="error" wrapText="true" />
            </VBox>
        </ScrollPane>
    </VBox>

    <VBox spacing="20" styleClass="card" HBox.hgrow="ALWAYS">
        <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label styleClass="title" text="Sản phẩm bạn đang bán" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onRefresh" prefWidth="120" text="Làm mới" />
            <Button onAction="#onDelete" prefWidth="160" text="Xóa mục chọn" />
        </HBox>
        <TableView fx:id="myAuctionsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="400" text="Tên sản phẩm" />
                <TableColumn fx:id="priceCol" prefWidth="200" text="Giá cao nhất hiện tại" />
                <TableColumn fx:id="bidsCol" prefWidth="150" text="Số lượt thầu" />
                <TableColumn fx:id="endsCol" prefWidth="250" text="Thời gian kết thúc" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>